<resources>

    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@drawable/launch_screen</item>
        <item name="android:navigationBarColor">@color/rentalhub_navy</item>
        <item name="android:statusBarColor">@color/rentalhub_navy</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!--
      Android 12+ ignores android:windowBackground on the launch theme and draws the
      system splash instead, so the Amana mark has to live in the icon slot. The
      composite holds the logo mark with Amana beneath it, sized to survive the
      circular mask.
    -->
    <style name="LaunchTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/amana_launch_composite</item>
        <item name="windowSplashScreenBackground">@color/rentalhub_navy</item>
        <item name="windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="windowSplashScreenAnimationDuration">900</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>

</resources>
