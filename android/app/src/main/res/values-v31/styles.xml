<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:navigationBarColor">@color/rentalhub_navy</item>
        <item name="android:statusBarColor">@color/rentalhub_navy</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/rentalhub_splash_mark</item>
        <item name="android:windowSplashScreenBackground">@color/rentalhub_navy</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/rentalhub_navy</item>
        <item name="android:windowSplashScreenAnimationDuration">3600</item>
    </style>

    <style name="LaunchTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/rentalhub_splash_mark</item>
        <item name="windowSplashScreenBackground">@color/rentalhub_navy</item>
        <item name="windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="windowSplashScreenAnimationDuration">900</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>
</resources>
