{
  "name": "rentalhubmobile",
  "private": true,
  "version": "1.0.73",
  "main": "index.js",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "web": "expo start --web",
    "postinstall": "patch-package",
    "build:android": "node scripts/verify-push-config.cjs && cd android && ./gradlew assembleRelease",
    "build:android:bundle": "node scripts/verify-push-config.cjs && cd android && ./gradlew bundleRelease",
    "build:ios": "cd ios && xcodebuild -workspace RentalHubMobile.xcworkspace -scheme RentalHubMobile -configuration Release",
    "build:app": "node scripts/build-all.js",
    "sync:version": "node scripts/sync-app-version.cjs",
    "test:language": "node scripts/verify-language-layout.cjs",
    "test:tour": "node scripts/verify-tour-system.cjs",
    "test:typography": "node scripts/verify-typography.cjs",
    "test:localization": "node scripts/verify-login-language.cjs && node scripts/verify-interface-localization.cjs --customer && node scripts/audit-customer-inline-copy.cjs --check && node scripts/verify-customer-catalogues.cjs",
    "test:registration": "node scripts/verify-registration-action.cjs",
    "test:support": "node scripts/verify-support-centre.cjs && node --test scripts/test-whatsapp-support.cjs src/services/__tests__/*.test.cjs",
    "test:protection": "node --test scripts/test-property-protection.cjs src/services/__tests__/privatePropertyFileService.test.cjs",
    "test:survey": "node --test scripts/test-survey-progress.cjs",
    "test:parity": "node scripts/audit-platform-contracts.cjs && node --test scripts/test-platform-parity.cjs scripts/test-public-survey.cjs scripts/test-build-compat.cjs",
    "test:startup": "node --test scripts/test-startup-flow.cjs && node scripts/verify-language-layout.cjs && node scripts/verify-update-resume.cjs && node scripts/verify-update-version.cjs",
    "test:notifications": "node --test scripts/test-notification-navigation.cjs",
    "test:call-sounds": "node --test scripts/test-call-sounds.cjs scripts/test-call-connection.cjs scripts/test-native-call-media.cjs",
    "prepare:call-sounds": "node scripts/prepare-call-sounds.cjs",
    "verify:push-config": "node scripts/verify-push-config.cjs"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-ml-kit/face-detection": "^2.0.1",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.11.0",
    "axios": "^1.7.2",
    "expo": "~55.0.27",
    "expo-asset": "~55.0.17",
    "expo-audio": "~55.0.18",
    "expo-camera": "~55.0.23",
    "expo-constants": "~55.0.16",
    "expo-device": "~55.0.21",
    "expo-document-picker": "~55.0.17",
    "expo-file-system": "~55.0.26",
    "expo-font": "~55.0.8",
    "expo-notifications": "~55.0.27",
    "expo-sharing": "~55.0.24",
    "expo-speech": "~55.0.18",
    "expo-video": "~55.0.21",
    "expo-web-browser": "~55.0.20",
    "jwt-decode": "^4.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "^2.16.2",
    "react-native-image-picker": "^7.1.2",
    "react-native-keychain": "^10.0.0",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-toast-message": "^2.2.0",
    "react-native-vector-icons": "^10.1.0",
    "react-native-web": "^0.21.0",
    "react-native-webrtc": "^124.0.7",
    "react-native-webview": "^13.16.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@react-native-community/cli": "^20.1.3",
    "@react-native/metro-config": "^0.83.10",
    "@react-navigation/stack": "^6.4.1",
    "babel-preset-expo": "^55.0.12",
    "patch-package": "^8.0.1"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.9.8",
    "browserslist": "^4.24.4",
    "image-size": "^2.0.3",
    "js-yaml": "^4.1.1",
    "qs": "^6.16.1",
    "minimatch@>=7 <11.0.1": "^11.0.1",
    "glob@>=9 <=14.0.1": "^14.0.2",
    "decode-uri-component": "^0.5.1",
    "uuid": "^11.1.1",
    "shell-quote": "^1.11.0",
    "source-map-js": "^1.2.2",
    "node-forge": "^1.4.3",
    "follow-redirects": "^1.16.2",
    "joi": "^17.13.9",
    "launch-editor": "^2.14.2",
    "zod": "^4.6.6",
    "fast-xml-parser": "^5.11.3",
    "compression": "^1.8.2",
    "body-parser@>=2 <2.4.0": "^2.4.0"
  }
}
