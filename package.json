{
  "name": "rentalhubmobile",
  "private": true,
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "web": "expo start --web",
    "postinstall": "patch-package",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:android:bundle": "cd android && ./gradlew bundleRelease",
    "build:ios": "cd ios && xcodebuild -workspace RentalHubMobile.xcworkspace -scheme RentalHubMobile -configuration Release",
    "build:app": "node scripts/build-all.js",
    "test:tour": "node scripts/verify-tour-system.cjs"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-ml-kit/face-detection": "^2.0.1",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.11.0",
    "axios": "^1.7.2",
    "expo": "~55.0.27",
    "expo-asset": "~55.0.17",
    "expo-camera": "~55.0.0",
    "expo-constants": "~55.0.16",
    "expo-device": "~55.0.19",
    "expo-file-system": "~55.0.26",
    "expo-font": "~55.0.8",
    "expo-notifications": "~55.0.25",
    "expo-sharing": "~55.0.24",
    "jwt-decode": "^4.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "^2.16.2",
    "react-native-image-picker": "^7.1.2",
    "react-native-keychain": "^10.0.0",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-toast-message": "^2.2.0",
    "react-native-vector-icons": "^10.1.0",
    "react-native-web": "^0.21.0",
    "react-native-webrtc": "^124.0.7",
    "react-native-webview": "^13.16.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@react-native-community/cli": "^20.1.3",
    "@react-native/metro-config": "^0.83.10",
    "@react-navigation/stack": "^6.4.1",
    "babel-preset-expo": "^55.0.12",
    "patch-package": "^8.0.1"
  }
}
